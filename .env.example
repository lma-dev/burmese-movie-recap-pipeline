APP_NAME="Burmese Movie Recap Pipeline"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=burmese_recap
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=log
CACHE_STORE=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# =========================================
# AI provider keys (read by Python scripts)
# =========================================
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_CHAT_MODEL=gpt-4o-mini

# Microsoft Edge TTS — no API key needed (uses unauthenticated edge-tts endpoint).
# Override the default Burmese voice if you want.
EDGE_TTS_VOICE=my-MM-NilarNeural

# =========================================
# Pipeline runtime
# =========================================
PYTHON_BIN=python3
PYTHON_SCRIPTS_PATH=python
PIPELINE_STORAGE_DISK=local
PIPELINE_STORAGE_ROOT=pipeline

# Default reel frame size (id from config/pipeline.php)
DEFAULT_FRAME_PRESET=reel_9x16

# yt-dlp binary (must be installed on the host)
YT_DLP_BIN=yt-dlp
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
